{
  "name": "@proliferate/design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./palette": {
      "types": "./dist/palette.d.ts",
      "import": "./dist/palette.js"
    },
    "./rungs": {
      "types": "./dist/rungs.d.ts",
      "import": "./dist/rungs.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.js"
    },
    "./cadence": {
      "types": "./dist/cadence.d.ts",
      "import": "./dist/cadence.js"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "import": "./dist/react-native.js"
    },
    "./theme.css": "./dist/theme.css",
    "./product.css": "./dist/css/product.css",
    "./desktop.css": "./dist/css/desktop.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/generate-theme.mjs && node scripts/generate-profiles.mjs && node scripts/copy-css.mjs && node scripts/check-theme.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "geist": "^1.7.2",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "typescript": "^5.7"
  }
}
