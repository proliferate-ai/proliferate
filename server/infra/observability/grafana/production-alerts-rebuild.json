  "notificationPolicy": {
    "receiver": "grafana-default-sns",
    "group_by": [
      "grafana_folder",
      "alertname"
    ],
    "routes": [
      {
        "receiver": "grafana-default-sns",
        "object_matchers": [
          [
            "__grafana_autogenerated__",
            "=",
            "true"
          ]
        ],
        "routes": [
          {
            "receiver": "grafana-default-sns",
            "group_by": [
              "grafana_folder",
              "alertname"
            ],
            "object_matchers": [
              [
                "__grafana_receiver__",
                "=",
                "grafana-default-sns"
              ]
            ]
          }
        ]
      }
    ]
  },
  "contactPoint": {
    "name": "grafana-default-sns",
    "uid": "bfvtw9if8c3cwd",
    "integrationName": "sns receiver",
    "type": "sns",
    "disableResolveMessage": false,
    "settings": {
      "topic": "arn:aws:sns:us-east-1:157466816238:grafana-proliferate-ops-alerts",
